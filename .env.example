# Copy this file to .env.local for local development.
# Never commit real values.
GROQ_API_KEY=your_groq_api_key_here

# Shared pilot password. Use at least 12 random characters.
SITE_PASSWORD=replace_with_a_strong_founder_password

# Signs the httpOnly session cookie. Generate at least 32 random bytes.
# PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
SESSION_SECRET=replace_with_a_long_random_secret

